# ==============================================================================
# BrandKotha — Environment Variables Template
# Copy this file to .env before starting the development environment:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform & Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
APP_NAME="BrandKotha"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=brandkotha_user
POSTGRES_PASSWORD=brandkotha_secret_password
POSTGRES_DB=brandkotha_db

# Async Database URI used by FastAPI / SQLAlchemy asyncpg:
DATABASE_URL=postgresql+asyncpg://brandkotha_user:brandkotha_secret_password@localhost:5432/brandkotha_db

# Sync Database URI used by Alembic migrations:
SYNC_DATABASE_URL=postgresql://brandkotha_user:brandkotha_secret_password@localhost:5432/brandkotha_db

# ------------------------------------------------------------------------------
# 3. Cache & PubSub (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Asynchronous Task Queue (Celery)
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# 5. Security & JWT Session Lifecycle
# ------------------------------------------------------------------------------
# Generate a secure 32-byte secret: openssl rand -hex 32
JWT_SECRET_KEY=change_me_to_a_super_secret_cryptographic_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 6. Monetization Feature Flag (Built Behind Server Switch)
# ------------------------------------------------------------------------------
# False during closed/open trial (100% free), True in production:
CHARGE_ENABLED=False
DEFAULT_COMMISSION_PCT=10.00
DEFAULT_LEAD_FEE_BDT=199

# ------------------------------------------------------------------------------
# 7. Payment Gateways (Bangladeshi Rails - Test Credentials)
# ------------------------------------------------------------------------------
BKASH_APP_KEY=sandbox_app_key
BKASH_APP_SECRET=sandbox_app_secret
BKASH_USERNAME=sandbox_username
BKASH_PASSWORD=sandbox_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=testbox_password
SSLCOMMERZ_IS_SANDBOX=True

# ------------------------------------------------------------------------------
# 8. Frontend Public Configurations
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

